{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://telegram.org; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' https://juliproz-store.vercel.app/images/ https://qhgzzhgxwpcctafpzjid.supabase.co/functions/v1/product-photo/; connect-src 'self' https://www.juliproz.com https://qhgzzhgxwpcctafpzjid.supabase.co; object-src 'none'; base-uri 'none'; form-action 'self'; upgrade-insecure-requests; frame-ancestors 'self' https://web.telegram.org"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/(admin|admin.html|admin/)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' https://juliproz-store.vercel.app/images/ data: https://qhgzzhgxwpcctafpzjid.supabase.co/functions/v1/product-photo/; connect-src 'self' https://www.juliproz.com https://qhgzzhgxwpcctafpzjid.supabase.co; object-src 'none'; base-uri 'none'; form-action 'self'; upgrade-insecure-requests; frame-ancestors 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/photo-worker.js",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' https://www.juliproz.com; object-src 'none'; base-uri 'none'"
        }
      ]
    }
  ],
  "buildCommand": "node scripts/configure-telegram.cjs && node scripts/build-public.cjs",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/terms.html",
      "destination": "/api/legal-page?page=terms"
    },
    {
      "source": "/privacy.html",
      "destination": "/api/legal-page?page=privacy"
    },
    {
      "source": "/",
      "destination": "/api/site-page?page=home"
    },
    {
      "source": "/catalog",
      "destination": "/api/site-page?page=catalog"
    },
    {
      "source": "/outlet",
      "destination": "/api/site-page?page=outlet"
    },
    {
      "source": "/services",
      "destination": "/api/site-page?page=services"
    },
    {
      "source": "/sell",
      "destination": "/api/site-page?page=sell"
    },
    {
      "source": "/brands/:slug",
      "destination": "/api/site-page?page=brand&slug=:slug"
    },
    {
      "source": "/product/:id",
      "destination": "/api/product-page?id=:id"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/telegram/",
      "destination": "https://app.juliproz.com/index.html"
    },
    {
      "source": "/telegram/:path*",
      "destination": "https://app.juliproz.com/:path*"
    },
    {
      "source": "/images/:path*",
      "destination": "/api/product-photo?path=:path*"
    }
  ],
  "redirects": [
    {
      "source": "/catalog",
      "has": [
        {
          "type": "host",
          "value": "juliproz-store.vercel.app"
        }
      ],
      "destination": "https://www.juliproz.com/catalog",
      "statusCode": 301
    },
    {
      "source": "/outlet",
      "has": [
        {
          "type": "host",
          "value": "juliproz-store.vercel.app"
        }
      ],
      "destination": "https://www.juliproz.com/outlet",
      "statusCode": 301
    },
    {
      "source": "/services",
      "has": [
        {
          "type": "host",
          "value": "juliproz-store.vercel.app"
        }
      ],
      "destination": "https://www.juliproz.com/services",
      "statusCode": 301
    },
    {
      "source": "/sell",
      "has": [
        {
          "type": "host",
          "value": "juliproz-store.vercel.app"
        }
      ],
      "destination": "https://www.juliproz.com/sell",
      "statusCode": 301
    },
    {
      "source": "/brands/:slug",
      "has": [
        {
          "type": "host",
          "value": "juliproz-store.vercel.app"
        }
      ],
      "destination": "https://www.juliproz.com/brands/:slug",
      "statusCode": 301
    },
    {
      "source": "/product/:id",
      "has": [
        {
          "type": "host",
          "value": "juliproz-store.vercel.app"
        }
      ],
      "destination": "https://www.juliproz.com/product/:id",
      "statusCode": 301
    },
    {
      "source": "/terms.html",
      "has": [
        {
          "type": "host",
          "value": "juliproz-store.vercel.app"
        }
      ],
      "destination": "https://www.juliproz.com/terms.html",
      "statusCode": 301
    },
    {
      "source": "/privacy.html",
      "has": [
        {
          "type": "host",
          "value": "juliproz-store.vercel.app"
        }
      ],
      "destination": "https://www.juliproz.com/privacy.html",
      "statusCode": 301
    },
    {
      "source": "/telegram",
      "destination": "/telegram/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "product",
          "value": "(?<productId>[1-9][0-9]*)"
        },
        {
          "type": "host",
          "value": "www.juliproz.com"
        }
      ],
      "destination": "/product/:productId",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:page(catalog|outlet|services|sell)/",
      "destination": "/:page",
      "permanent": true
    },
    {
      "source": "/brands/:slug/",
      "destination": "/brands/:slug",
      "permanent": true
    },
    {
      "source": "/product/:id/",
      "destination": "/product/:id",
      "permanent": true
    }
  ],
  "functions": {
    "api/product-photo.js": {
      "includeFiles": "private-product-assets/**"
    },
    "api/telegram-delivery.js": {
      "maxDuration": 120
    },
    "api/product-page.js": {
      "includeFiles": "{index.html,site-translations.js,product-translations.js,product-copy.js,site-language.js}"
    },
    "api/site-page.js": {
      "includeFiles": "{index.html,site-translations.js,product-translations.js,product-copy.js,site-language.js}"
    },
    "api/legal-page.js": {
      "includeFiles": "{terms.html,privacy.html,site-translations.js,product-translations.js,product-copy.js,site-language.js}"
    }
  },
  "crons": [
    {
      "path": "/api/telegram-delivery",
      "schedule": "* * * * *"
    }
  ],
  "regions": [
    "dub1"
  ]
}
